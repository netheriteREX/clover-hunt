MISTRAL_API_KEY=
PORT=8787
# Small/fast model for query-generation + debating (runs twice per debate).
MISTRAL_MODEL_SMALL=mistral-small-latest
# Large model reserved for the judge's methodology critique (runs once).
MISTRAL_MODEL_LARGE=mistral-large-latest

# Optional: OpenAlex needs no key at all, but adding your email here moves
# requests into their "polite pool" for faster, more reliable rate limits.
# Not a registered key — just a plain email string. https://docs.openalex.org
OPENALEX_MAILTO=
