ANTHROPIC_API_KEY=
PORT=8787
# Optional: comma-separated frontend origins allowed to call this API when
# deployed (e.g. https://main.xxxx.amplifyapp.com). Unset allows any origin.
ALLOWED_ORIGINS=
# Small/fast model for query-generation + debating (runs twice per debate)
# and Steelman Trainer's sparring turns.
ANTHROPIC_MODEL_SMALL=claude-haiku-4-5-20251001
# Larger model reserved for the judge's methodology critique and Steelman
# Trainer's closing summary (both run once per session).
ANTHROPIC_MODEL_JUDGE=claude-sonnet-5

# Optional: OpenAlex needs no key at all, but adding your email here moves
# requests into their "polite pool" for faster, more reliable rate limits.
# Not a registered key — just a plain email string. https://docs.openalex.org
OPENALEX_MAILTO=
